diff --git a/scripts/import_platform.py b/scripts/import_platform.py
new file mode 100644
index 000000000..f716df0a9
--- /dev/null
+++ b/scripts/import_platform.py
@@ -0,0 +1,21 @@
+
+import importlib.util
+import os
+import sysconfig
+
+def get_platform_module():
+    """
+    Loads stdlib's 'platform' module explicitly.
+
+    The mupdf source tree contains a 'platform/' directory that can shadow the
+    stdlib module when the source root is on sys.path (notably on Windows).
+    """
+    spec = importlib.util.spec_from_file_location(
+            'platform',
+            os.path.join(sysconfig.get_path('stdlib'), 'platform.py'),
+            )
+    platform_module = importlib.util.module_from_spec(spec)
+    spec.loader.exec_module(platform_module)
+    return platform_module
+
+platform = get_platform_module()
